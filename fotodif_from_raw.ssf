# DSLR RAW -> FITS alineados para FotoDif
#
# Siril 1.2 o posterior. Camaras Bayer (Canon, Nikon, Sony, Pentax).
# No sirve para sensores Fuji X-Trans.
#
# Lee los RAW solo de E:/Frames/SequenceFotodiffIN
# (CR2, CR3, NEF, ARW, ...). No mezcles darks, flats ni otras noches.
# Escribe la secuencia para FotoDif en E:/Frames/SequenceFotodiffOUT:
#   fotodif_Green_light_XXXXX.fit
# Los FITS intermedios quedan en E:/Frames/SequenceFotodiffIN/process.
# Borra esa carpeta process antes de volver a lanzar el script.
# No cargues en FotoDif los light_*.fit ni los Green_light_*.fit.
#
# Desde la interfaz o la terminal, el directorio de trabajo de Siril da igual:
#   siril-cli -s fotodif_from_raw.ssf
#
# Cada FITS es monocromo, 16 bits, sin compresion, canal verde Bayer
# (media de los dos fotositos verdes, mitad de resolucion, sin debayer).
# El alineado es solo traslacion, en pixeles enteros, para no alterar las
# cuentas. La escala no es el ADU nativo de 14 bits: Siril la lleva a
# 16 bits. La fotometria diferencial no cambia.
#
# En FotoDif reduce los anillos: la imagen mide la mitad en cada eje.
# Si el registro descarta tomas, baja -minpairs o revisa nubes y foco.
# Si hubo giro de campo, este script no lo corrige: un giro necesita
# Similarity e interpolacion, y eso modifica los ADU.
#
# Antes de lanzarlo, en Preferencias / RAW deja gamma lineal y el balance
# de blancos de camara y automatico desactivados. Es el ajuste por defecto.
# No calibra bias, dark ni flat, y no apila.

requires 1.2.0

# Siril 1.2.6 aborta el script si una clave de set no existe.
# core.fits_save_icc aparece solo en versiones posteriores.
set16bits
setcompress 0
set core.extension=.fit

cd E:/Frames/SequenceFotodiffIN

convertraw light -out=E:/Frames/SequenceFotodiffIN/process

cd E:/Frames/SequenceFotodiffIN/process

seqextract_Green light

register Green_light -2pass -transf=shift -minpairs=10

# -interp=none conserva las cuentas. En Siril 1.2.6 no puede
# combinarse con -framing=min, porque ese modo cambia el tamano.
# El prefijo con ruta deja solo la secuencia final en SequenceFotodiffOUT.
seqapplyreg Green_light -interp=none -prefix=E:/Frames/SequenceFotodiffOUT/fotodif_
